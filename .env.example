# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=acadpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_password@localhost:5432/acadpulse

# Security & JWT
# Generate a secure key e.g.: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_hex_key_for_development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="AcadPulse API"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ML Model Runtime
MODEL_ARTIFACTS_DIR=ml/artifacts
DEFAULT_MODEL_VERSION=v1.0.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
